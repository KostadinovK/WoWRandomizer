@page "/"
@using WoWRandomizer.Shared
@using WoWRandomizer.Web.Services
@implements IDisposable
@inject IComboApiClient ComboApiClient
@inject IRollHistory History

<h1>Roll your next character</h1>

<p>Can't decide what to play? Let the fate choose.</p>

<div class="faction-selector" role="group" aria-labelledby="faction-label">
    <span id="faction-label" class="faction-label">Faction</span>
    <div class="faction-options">
        @foreach (var option in FactionOptions)
        {
            var isSelected = _selectedFaction == option.Value;
            <button type="button"
                    class="@GetOptionClass(option.Value, isSelected)"
                    aria-pressed="@(isSelected ? "true" : "false")"
                    disabled="@_isRolling"
                    @onclick="() => ToggleFaction(option.Value)">
                <GameIcon Src="@IconPaths.Faction(option.Label)" Name="@option.Label" />
                <span class="faction-option-name">@option.Label</span>
            </button>
        }
    </div>
    <p class="faction-hint">@(_selectedFaction is null ? "No faction selected: any faction." : $"Only {_selectedFaction} combos.")</p>
</div>

<button type="button" class="roll-button" disabled="@_isRolling" @onclick="RollAsync">
    @(_isRolling ? "Rolling…" : "Roll")
</button>

@if (_isRolling)
{
    <p class="loading" role="status">Rolling the dice…</p>
}

<div class="result-region" aria-live="polite">
    @if (_combo is not null)
    {
        <section class="result @GetFactionClass(_combo.Faction) class-@IconPaths.Slug(_combo.Class)">
            <p class="result-title">
                <span class="result-part">
                    <GameIcon Src="@IconPaths.Race(_combo.Race)" Alt="@_combo.Race" Name="@_combo.Race" />
                    <span class="result-race">@_combo.Race</span>
                </span>
                <span class="result-part">
                    <GameIcon Src="@IconPaths.Class(_combo.Class)" Alt="@_combo.Class" Name="@_combo.Class" />
                    <span class="result-class">@_combo.Class</span>
                </span>
            </p>
            <p class="result-faction">
                <GameIcon Src="@IconPaths.Faction(_combo.Faction)" Alt="@_combo.Faction" Name="@_combo.Faction" />
                <span class="result-faction-name">@_combo.Faction</span>
            </p>
        </section>
    }
</div>

<RollHistoryList Entries="History.Entries" OnClear="History.Clear" />

@if (_errorMessage is not null)
{
    <div class="error" role="alert">
        <p class="error-message">@_errorMessage</p>
        <button type="button" class="retry-button" disabled="@_isRolling" @onclick="RollAsync">Try again</button>
    </div>
}

@code {
    private const string UnreachableMessage = "We couldn't reach the server. Check your connection and try again.";
    private const string ApiErrorMessage = "Something went wrong while rolling your character. Please try again.";

    private static readonly (string Value, string Label)[] FactionOptions =
    [
        ("horde", "Horde"),
        ("alliance", "Alliance")
    ];

    private readonly CancellationTokenSource _cancellation = new();

    private string? _selectedFaction;
    private bool _isRolling;
    private ComboResponse? _combo;
    private string? _errorMessage;

    // Clicking the selected faction again clears it, which means any faction.
    private void ToggleFaction(string faction) => _selectedFaction = _selectedFaction == faction ? null : faction;

    private async Task RollAsync()
    {
        // The button is disabled while rolling; this also guards against a second click getting through.
        if (_isRolling)
        {
            return;
        }

        _isRolling = true;
        _combo = null;
        _errorMessage = null;

        try
        {
            _combo = await ComboApiClient.GetRandomComboAsync(_selectedFaction, _cancellation.Token);
            History.Add(_combo);
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The page was left while the request was running; there is nothing to show.
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException)
        {
            // Network failure, API not running, CORS or timeout.
            _errorMessage = UnreachableMessage;
        }
        catch (ComboApiException)
        {
            _errorMessage = ApiErrorMessage;
        }
        finally
        {
            _isRolling = false;
        }
    }

    private static string GetOptionClass(string faction, bool isSelected) =>
        $"faction-option faction-option-{faction}{(isSelected ? " selected" : string.Empty)}";

    private static string GetFactionClass(string faction) => faction.ToLowerInvariant() switch
    {
        "horde" => "faction-horde",
        "alliance" => "faction-alliance",
        _ => string.Empty
    };

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
